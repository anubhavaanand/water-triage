# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets — never commit
.env

# local dev databases
data/*.db

# bulk data files stay local, not in git
data/raw/**/*.csv
!data/raw/**/README.md

# Large 3D Assets & heavy GeoJSON
*.glb
dashboard/assets/*.glb
dashboard/assets/india_states.geojson
*.log

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
# Playwright CLI output (may contain credentials)
.playwright-cli/
