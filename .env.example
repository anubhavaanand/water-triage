# WaterTriage Environment Configuration
# Copy to .env and fill in your actual values.
# NEVER commit .env to version control.

# PostgreSQL database URL (used in production via Docker/Render)
# Local dev uses SQLite: DATABASE_URL="sqlite:///data/watertriage.db"
# Production: DATABASE_URL="postgresql://jjm_user:YOUR_PASSWORD@db:5432/jjm_triage"
DATABASE_URL="sqlite:///data/watertriage.db"

# PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=jjm_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=jjm_triage
